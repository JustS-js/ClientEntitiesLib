	"mixins": [{
		"config": "cel.client.mixins.json",
		"environment": "client"
	}],
	"depends": {
		"fabricloader": ">=0.18.2",
		"minecraft": ">=1.21.8 <1.21.10",
		"java": ">=21",
		"fabric-api": "*"
	},
	"accessWidener" : "cel.accesswidener",
	"custom": {
		"modmenu": {
			"badges": [ "library" ]
		}
	}
