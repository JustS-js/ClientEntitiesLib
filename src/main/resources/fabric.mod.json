{
	"schemaVersion": 1,
	"id": "cel",
	"version": "${version}",
	"name": "Client Entities Lib",
	"description": "Library for creating and managing client-side entities",
	"authors": [
		"Just_S"
	],
	"contact": {},
	"license": "MIT",
	"icon": "assets/cel/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"justs_js.cel.CELModLib"
		]
